# Python 环境与缓存
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# 构建产物（Python / Rust）
*.egg-info/
dist/
build/
target/

# 开发工具与系统文件
.idea/
.vscode/
.claude/
*.swp
.DS_Store

# 本机数据与凭证
# local/ 保存凭证、运行状态、学习模型、训练样本和个人笔记。
/local/
# 证书由 gen_cert.py 在本机生成。
pf_intercept/certs/

# 运行日志与抓包（可能包含凭证和对局数据）
*.log
*.mitm
logs/
pf_intercept/logs/

# 本地分析与历史记录
# 长期维护文档随对应模块入库。
/docs/

# 客户端热更新缓存
# hotupdate.py 从 CDN 同步；入库的 output/ 只保存安装包基线。
pf_reverse/remote_res/
